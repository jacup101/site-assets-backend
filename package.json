{
  "name": "site-assets-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to /tmp/site-assets-backend-wrangler-state",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply site-assets-db --local --persist-to /tmp/site-assets-backend-wrangler-state",
    "db:migrate:remote": "wrangler d1 migrations apply site-assets-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "~5.6.2",
    "wrangler": "^4.86.0"
  }
}
